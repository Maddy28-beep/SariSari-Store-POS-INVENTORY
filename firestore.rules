rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : null;
    }

    function isActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().isActive == true;
    }

    function isOwnerOrAdmin() {
      return isActive() && (myRole() == 'owner' || myRole() == 'admin');
    }

    function isOwner() {
      return isActive() && myRole() == 'owner';
    }

    // Users: everyone signed in can read (needed for cashier-name lookups in reports);
    // only Owner can create/edit roles; a user may edit their own name.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner();
      allow update: if isOwner()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive);
      allow delete: if false;
    }

    // Catalog data: read by any active staff, write by Owner/Admin only.
    match /categories/{id} {
      allow read: if isActive();
      allow write: if isOwnerOrAdmin();
    }
    match /units/{id} {
      allow read: if isActive();
      allow write: if isOwnerOrAdmin();
    }
    match /suppliers/{id} {
      allow read: if isActive();
      allow write: if isOwnerOrAdmin();
    }

    // Products: everyone active can read (POS needs it); only Owner/Admin can create/edit.
    // currentStock is also touched by cashiers indirectly via sale transactions, so allow
    // active staff to update just stock-related fields while keeping price edits Owner/Admin-only.
    match /products/{id} {
      allow read: if isActive();
      allow create: if isOwnerOrAdmin();
      allow update: if isOwnerOrAdmin()
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['currentStock', 'updatedAt']));
      allow delete: if false;
    }

    // Cost prices live here, so cashiers can't read them.
    match /productBatches/{id} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin();
      allow update, delete: if false;
    }

    match /inventoryTransactions/{id} {
      allow read: if isOwnerOrAdmin();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Sales are an append-only ledger written by the cashier who made the sale.
    // The only allowed mutation after creation is the void-request lifecycle:
    //   1. Any active staff member can flag a completed sale as a pending void request.
    //   2. Only Owner/Admin can approve (marks it voided) or reject a pending request.
    match /sales/{saleId} {
      allow read: if isActive();
      // Cashiers can't discount: only Owner/Admin may record a sale with a discount.
      // A cashier's discount needs an approved request (same amount, theirs) from an Owner/Admin.
      allow create: if isActive() && request.resource.data.cashierId == request.auth.uid
        && (request.resource.data.get('discount', 0) == 0 || isOwnerOrAdmin()
            || (exists(/databases/$(database)/documents/inventoryRequests/$(request.resource.data.get('discountRequestId', 'none')))
                && get(/databases/$(database)/documents/inventoryRequests/$(request.resource.data.get('discountRequestId', 'none'))).data.kind == 'discount'
                && get(/databases/$(database)/documents/inventoryRequests/$(request.resource.data.get('discountRequestId', 'none'))).data.status == 'approved'
                && get(/databases/$(database)/documents/inventoryRequests/$(request.resource.data.get('discountRequestId', 'none'))).data.requestedBy == request.auth.uid
                && get(/databases/$(database)/documents/inventoryRequests/$(request.resource.data.get('discountRequestId', 'none'))).data.payload.amount == request.resource.data.discount));

      allow update: if isActive()
        && resource.data.status == 'completed'
        && resource.data.get('voidStatus', null) in [null, 'rejected']
        && request.resource.data.voidStatus == 'pending'
        && request.resource.data.voidRequestedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voidStatus', 'voidRequestedBy', 'voidRequestedAt', 'voidReason']);

      allow update: if isOwnerOrAdmin()
        && resource.data.get('voidStatus', null) == 'pending'
        && request.resource.data.voidStatus in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voidStatus', 'status', 'voidReviewedBy', 'voidReviewedAt', 'voidReviewNote']);

      allow delete: if false;

      match /items/{itemId} {
        allow read: if isActive();
        allow create: if isActive();
        allow update, delete: if false;
      }
    }

    // Customers: any active staff can add (at the POS); only Owner/Admin can edit. History is
    // read from the sales ledger, so nothing about a customer's purchases lives here.
    match /customers/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if isOwnerOrAdmin();
      allow delete: if false;
    }

    // Cashiers can log expenses and see only their own; deleting is Owner/Admin only.
    match /expenses/{id} {
      allow read: if isOwnerOrAdmin() || (isActive() && resource.data.recordedBy == request.auth.uid);
      allow create: if isActive() && request.resource.data.recordedBy == request.auth.uid;
      allow update, delete: if isOwnerOrAdmin();
    }

    // Partial refunds are written only by an Owner/Admin (directly, or when approving a
    // cashier's refund request) together with the stock restore.
    match /refunds/{id} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin();
      allow update, delete: if false;
    }

    // Cashier-proposed products / stock-ins. Nothing reaches the real inventory until an
    // Owner/Admin approves (the approval itself is what writes products and stock).
    match /inventoryRequests/{id} {
      allow read: if isOwnerOrAdmin() || (isActive() && resource.data.requestedBy == request.auth.uid);
      allow create: if isActive() && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isOwnerOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']);
      // The requesting cashier may flip their own approved discount to 'used' when the sale is rung.
      allow update: if isActive() && resource.data.requestedBy == request.auth.uid
        && resource.data.kind == 'discount' && resource.data.status == 'approved'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isOwnerOrAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }

    // Reports run a collectionGroup('items') query across every sale's line items.
    // A nested match under /sales/{id}/items only covers direct subcollection reads —
    // collectionGroup queries need this separate wildcard rule to be authorized.
    match /{path=**}/items/{itemId} {
      allow read: if isActive();
    }
  }
}
